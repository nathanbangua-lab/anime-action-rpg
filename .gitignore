import math
import random
import sys
from dataclasses import dataclass

import pygame


WIDTH, HEIGHT = 1280, 720
WORLD_WIDTH, WORLD_HEIGHT = 2200, 2200

ELEMENTS = ["Pyro", "Hydro", "Cryo", "Electro", "Anemo", "Geo", "Dendro"]
REACTION_TABLE = {
    ("Pyro", "Hydro"): ("Vaporize", 1.9),
    ("Hydro", "Pyro"): ("Melt", 1.9),
    ("Electro", "Hydro"): ("Electro-Charged", 1.7),
    ("Hydro", "Electro"): ("Electro-Charged", 1.7),
    ("Cryo", "Electro"): ("Superconduct", 1.5),
    ("Electro", "Cryo"): ("Superconduct", 1.5),
    ("Hydro", "Cryo"): ("Freeze", 1.9),
    ("Cryo", "Hydro"): ("Freeze", 1.9),
    ("Pyro", "Dendro"): ("Catalyze", 1.7),
    ("Dendro", "Pyro"): ("Bloom", 1.8),
    ("Anemo", "Pyro"): ("Swirl", 1.3),
    ("Anemo", "Electro"): ("Swirl", 1.3),
    ("Anemo", "Hydro"): ("Swirl", 1.3),
    ("Anemo", "Cryo"): ("Swirl", 1.3),
}

ELEMENT_COLORS = {
    "Pyro": (255, 130, 60),
    "Hydro": (80, 160, 255),
    "Cryo": (165, 220, 255),
    "Electro": (180, 110, 255),
    "Anemo": (120, 240, 180),
    "Geo": (236, 200, 100),
    "Dendro": (120, 220, 80),
}


@dataclass
class Character:
    name: str
    element: str
    color: tuple
    hp: float
    max_hp: float
    attack_damage: float
    skill_damage: float
    burst_damage: float
    burst_charge: float
    level: int = 1
    x: float = 0.0
    y: float = 0.0
    radius: int = 18


@dataclass
class Enemy:
    x: float
    y: float
    radius: int
    element: str
    hp: float
    max_hp: float
    speed: float
    damage: float
    name: str = "Enemy"
    attack_cooldown: float = 0.0
    status: str = "None"
    status_timer: float = 0.0
    hit_flash: float = 0.0


@dataclass
class Chest:
    x: float
    y: float
    radius: int = 18
    opened: bool = False
    reward: str = "Primogems"


@dataclass
class Waypoint:
    x: float
    y: float
    radius: int = 25
    active: bool = False
    title: str = "Waypoint"


class Game:
    def __init__(self):
        pygame.init()
        self.screen = pygame.display.set_mode((WIDTH, HEIGHT))
        pygame.display.set_caption("Archon Rift: Elemental Dawn")
        self.clock = pygame.time.Clock()

        self.font = pygame.font.Font(None, 28)
        self.small_font = pygame.font.Font(None, 20)
        self.big_font = pygame.font.Font(None, 48)

        self.player = {"x": 800, "y": 700, "speed": 260, "radius": 18}
        self.camera_x = 0
        self.camera_y = 0

        self.party = [
            Character("Aether", "Pyro", (255, 140, 80), 130, 130, 28, 34, 60, 0),
            Character("Luna", "Hydro", (80, 180, 255), 130, 130, 24, 32, 55, 0),
            Character("Kiro", "Electro", (180, 110, 255), 130, 130, 26, 30, 58, 0),
            Character("Sora", "Cryo", (165, 220, 255), 130, 130, 25, 29, 54, 0),
        ]
        self.active_index = 0

        self.all_roster = [
            "Aether", "Luna", "Kiro", "Sora", "Niko", "Yuki", "Rin", "Mina",
            "Iris", "Kael", "Selene", "Vera"
        ]
        self.owned_roster = ["Aether", "Luna", "Kiro", "Sora"]
        self.primogems = 120

        self.quest_log = [
            {"title": "Reach the Skyfall Gate", "progress": 0, "goal": 1, "type": "waypoint"},
            {"title": "Defeat 6 Rift Creatures", "progress": 0, "goal": 6, "type": "kills"},
            {"title": "Open 2 hidden chests", "progress": 0, "goal": 2, "type": "chests"},
        ]

        self.enemies = []
        self.chests = [
            Chest(1540, 850),
            Chest(1260, 1460),
            Chest(480, 1020),
            Chest(1750, 320),
        ]
        self.waypoints = [
            Waypoint(1380, 720, title="Skyfall Gate", active=True),
            Waypoint(860, 1700, title="Sunset Ruins"),
            Waypoint(1700, 1450, title="Stormwatch Pass"),
        ]

        self.resin = 120
        self.max_resin = 120
        self.resin_tick = 0.0
        self.adventure_rank = 1
        self.world_level = 1
        self.score = 0

        self.message = "" 
        self.message_timer = 0.0
        self.game_over = False
        self.spawn_enemies()

    def spawn_enemies(self):
        for _ in range(12):
            x = random.randint(200, WORLD_WIDTH - 200)
            y = random.randint(200, WORLD_HEIGHT - 200)
            self.enemies.append(
                Enemy(
                    x=x,
                    y=y,
                    radius=18,
                    element=random.choice(ELEMENTS),
                    hp=70 + random.randint(0, 30),
                    max_hp=70 + random.randint(0, 30),
                    speed=random.randint(45, 90),
                    damage=8 + random.randint(0, 12),
                    name=random.choice(["Rift Bat", "Shine Wisp", "Stone Mimic", "Mist Fang"]),
                )
            )

    def update(self, dt):
        if self.game_over:
            return

        self.player_movement(dt)
        self.update_party(dt)
        self.update_enemies(dt)
        self.update_quests()
        self.update_ui(dt)

    def player_movement(self, dt):
        keys = pygame.key.get_pressed()
        dx = (keys[pygame.K_d] or keys[pygame.K_RIGHT]) - (keys[pygame.K_a] or keys[pygame.K_LEFT])
        dy = (keys[pygame.K_s] or keys[pygame.K_DOWN]) - (keys[pygame.K_w] or keys[pygame.K_UP])
        if dx or dy:
            length = math.hypot(dx, dy)
            move_x = (dx / length) * self.player["speed"] * dt
            move_y = (dy / length) * self.player["speed"] * dt
            self.player["x"] = max(30, min(WORLD_WIDTH - 30, self.player["x"] + move_x))
            self.player["y"] = max(30, min(WORLD_HEIGHT - 30, self.player["y"] + move_y))

    def update_party(self, dt):
        for idx, char in enumerate(self.party):
            if char.burst_charge < 100:
                char.burst_charge = min(100, char.burst_charge + 6 * dt)
            if idx == self.active_index:
                char.hp = min(char.max_hp, char.hp + 2 * dt)

    def update_enemies(self, dt):
        for enemy in self.enemies:
            dx = self.player["x"] - enemy.x
            dy = self.player["y"] - enemy.y
            dist = math.hypot(dx, dy)
            if dist > 0:
                if dist < 260:
                    move_speed = enemy.speed * dt
                    if enemy.status == "Freeze":
                        move_speed *= 0.2
                    enemy.x += (dx / dist) * move_speed
                    enemy.y += (dy / dist) * move_speed
                if dist < 26:
                    enemy.attack_cooldown -= dt
                    if enemy.attack_cooldown <= 0:
                        self.take_damage(enemy.damage)
                        enemy.attack_cooldown = 1.4
            if enemy.status != "None":
                enemy.status_timer -= dt
                if enemy.status == "Electro-Charged":
                    self.take_damage(3.5 * dt)
                if enemy.status == "Burn":
                    self.take_damage(2.5 * dt)
                if enemy.status == "Freeze":
                    enemy.speed *= 0.97
                if enemy.status_timer <= 0:
                    enemy.status = "None"
                    enemy.status_timer = 0.0
            enemy.hit_flash = max(0, enemy.hit_flash - dt)

    def take_damage(self, amount):
        active = self.party[self.active_index]
        active.hp -= amount
        if active.hp <= 0:
            active.hp = active.max_hp
            self.message = "Your active character was knocked out, but rallied back!"
            self.message_timer = 2.5
            self.active_index = (self.active_index + 1) % len(self.party)

    def perform_attack(self):
        active = self.party[self.active_index]
        target = self.find_closest_enemy(150)
        if not target:
            self.message = f"{active.name} lunges forward, but no enemy is in reach."
            self.message_timer = 1.2
            return

        damage = active.attack_damage
        reaction = self.evaluate_reaction(target.element, active.element)
        if reaction:
            name, mult = reaction
            damage *= mult
            target.status = name
            target.status_timer = 2.8
            self.message = f"{active.name} triggers {name}!"
        else:
            target.element = active.element
            self.message = f"{active.name} hits with {active.element} energy."

        target.hp -= damage
        target.hit_flash = 0.18
        if target.hp <= 0:
            self.kill_enemy(target)
            self.score += 20
            self.primogems += 5
        self.message_timer = 1.8

    def skill_attack(self):
        active = self.party[self.active_index]
        for enemy in self.enemies:
            if self.distance(self.player["x"], self.player["y"], enemy.x, enemy.y) < 200:
                damage = active.skill_damage
                reaction = self.evaluate_reaction(enemy.element, active.element)
                if reaction:
                    name, mult = reaction
                    damage *= mult
                    enemy.status = name
                    enemy.status_timer = 3.0
                    self.message = f"{active.name} unleashed {name}!"
                else:
                    enemy.element = active.element
                    self.message = f"{active.name} used {active.element} skill."
                enemy.hp -= damage
                enemy.hit_flash = 0.2
                if enemy.hp <= 0:
                    self.kill_enemy(enemy)
                    self.score += 30
                    self.primogems += 8
        self.message_timer = 2.2

    def burst_attack(self):
        active = self.party[self.active_index]
        if active.burst_charge < 100:
            self.message = f"{active.name}'s burst is not ready yet."
            self.message_timer = 1.2
            return

        for enemy in self.enemies:
            if self.distance(self.player["x"], self.player["y"], enemy.x, enemy.y) < 300:
                damage = active.burst_damage
                reaction = self.evaluate_reaction(enemy.element, active.element)
                if reaction:
                    name, mult = reaction
                    damage *= mult
                    enemy.status = name
                    enemy.status_timer = 4.0
                else:
                    enemy.element = active.element
                enemy.hp -= damage
                enemy.hit_flash = 0.25
                if enemy.hp <= 0:
                    self.kill_enemy(enemy)
                    self.score += 45
                    self.primogems += 10
        active.burst_charge = 0
        self.message = f"{active.name} unleashed a devastating burst!"
        self.message_timer = 2.4

    def evaluate_reaction(self, target_element, source_element):
        if target_element == source_element:
            return None
        return REACTION_TABLE.get((target_element, source_element)) or REACTION_TABLE.get((source_element, target_element))

    def kill_enemy(self, enemy):
        if enemy in self.enemies:
            self.enemies.remove(enemy)
            self.quest_log[1]["progress"] += 1
        self.resin = min(self.max_resin, self.resin + 4)

    def update_quests(self):
        for waypoint in self.waypoints:
            if self.distance(self.player["x"], self.player["y"], waypoint.x, waypoint.y) < 90:
                if waypoint.title == "Skyfall Gate" and self.quest_log[0]["progress"] < self.quest_log[0]["goal"]:
                    self.quest_log[0]["progress"] = 1

        for chest in self.chests:
            if not chest.opened and self.distance(self.player["x"], self.player["y"], chest.x, chest.y) < 55:
                chest.opened = True
                self.quest_log[2]["progress"] = min(self.quest_log[2]["goal"], self.quest_log[2]["progress"] + 1)
                self.primogems += 15
                self.message = "Chest opened! You found Primogems and refinement materials."
                self.message_timer = 2.0

        self.player["x"] = max(30, min(WORLD_WIDTH - 30, self.player["x"]))
        self.player["y"] = max(30, min(WORLD_HEIGHT - 30, self.player["y"]))

        if self.quest_log[1]["progress"] >= self.quest_log[1]["goal"]:
            self.adventure_rank += 1
            self.world_level = 1 + self.adventure_rank // 5
            self.quest_log[1]["goal"] += 2
            self.quest_log[1]["progress"] = 0

    def update_ui(self, dt):
        self.resin_tick += dt
        if self.resin_tick >= 12:
            self.resin = min(self.max_resin, self.resin + 1)
            self.resin_tick = 0

        if self.message_timer > 0:
            self.message_timer -= dt
        else:
            self.message = ""

        self.camera_x = max(0, min(WORLD_WIDTH - WIDTH, self.player["x"] - WIDTH // 2))
        self.camera_y = max(0, min(WORLD_HEIGHT - HEIGHT, self.player["y"] - HEIGHT // 2))

    def find_closest_enemy(self, radius):
        best = None
        best_dist = radius + 50
        for enemy in self.enemies:
            dist = self.distance(self.player["x"], self.player["y"], enemy.x, enemy.y)
            if dist < best_dist:
                best = enemy
                best_dist = dist
        return best

    @staticmethod
    def distance(x1, y1, x2, y2):
        return math.hypot(x2 - x1, y2 - y1)

    def handle_event(self, event):
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_SPACE:
                self.perform_attack()
            elif event.key == pygame.K_e:
                self.skill_attack()
            elif event.key == pygame.K_r:
                self.burst_attack()
            elif event.key == pygame.K_g:
                self.wish()
            elif event.key == pygame.K_1:
                self.active_index = 0
            elif event.key == pygame.K_2:
                self.active_index = 1
            elif event.key == pygame.K_3:
                self.active_index = 2
            elif event.key == pygame.K_4:
                self.active_index = 3
            elif event.key == pygame.K_q:
                self.resin = max(0, self.resin - 20)
                self.message = "You used Resin to claim a boss reward!"
                self.message_timer = 2.2
        elif event.type == pygame.MOUSEBUTTONDOWN:
            if event.button == 1:
                self.perform_attack()

    def wish(self):
        if self.primogems < 20:
            self.message = "Not enough Primogems for a wish."
            self.message_timer = 1.5
            return
        self.primogems -= 20
        new_name = random.choice(self.all_roster)
        if new_name not in self.owned_roster:
            self.owned_roster.append(new_name)
            self.message = f"New character acquired: {new_name}!"
        else:
            self.message = "The wish echoes with silence... but your stash is full."
        self.message_timer = 2.4

    def draw(self):
        self.screen.fill((18, 22, 38))
        self.draw_world()
        self.draw_hud()
        pygame.display.flip()

    def draw_world(self):
        world_surface = pygame.Surface((WORLD_WIDTH, WORLD_HEIGHT))
        world_surface.fill((26, 38, 58))

        for x in range(0, WORLD_WIDTH, 100):
            pygame.draw.line(world_surface, (40, 54, 72), (x, 0), (x, WORLD_HEIGHT), 1)
        for y in range(0, WORLD_HEIGHT, 100):
            pygame.draw.line(world_surface, (40, 54, 72), (0, y), (WORLD_WIDTH, y), 1)

        for chest in self.chests:
            color = (255, 224, 100) if not chest.opened else (90, 100, 110)
            pygame.draw.circle(world_surface, color, (int(chest.x), int(chest.y)), chest.radius)
            pygame.draw.circle(world_surface, (255, 255, 255), (int(chest.x), int(chest.y)), 5)

        for waypoint in self.waypoints:
            color = (120, 220, 170) if waypoint.active else (80, 100, 110)
            pygame.draw.circle(world_surface, color, (int(waypoint.x), int(waypoint.y)), waypoint.radius, 3)
            pygame.draw.line(world_surface, color, (waypoint.x, waypoint.y), (waypoint.x, waypoint.y - 30), 3)

        for enemy in self.enemies:
            color = ELEMENT_COLORS.get(enemy.element, (200, 220, 255))
            pygame.draw.circle(world_surface, color, (int(enemy.x), int(enemy.y)), enemy.radius)
            pygame.draw.circle(world_surface, (255, 255, 255), (int(enemy.x), int(enemy.y)), 7, 1)
            if enemy.hit_flash > 0:
                pygame.draw.circle(world_surface, (255, 255, 255), (int(enemy.x), int(enemy.y)), enemy.radius + 3, 3)

        active = self.party[self.active_index]
        pygame.draw.circle(world_surface, active.color, (int(self.player["x"]), int(self.player["y"])), self.player["radius"])
        pygame.draw.circle(world_surface, (255, 255, 255), (int(self.player["x"]), int(self.player["y"])), 12, 2)

        self.screen.blit(world_surface, (-self.camera_x, -self.camera_y))

    def draw_hud(self):
        active = self.party[self.active_index]

        panel = pygame.Rect(18, 18, 360, 170)
        pygame.draw.rect(self.screen, (20, 24, 35), panel, border_radius=12)
        pygame.draw.rect(self.screen, (55, 60, 90), panel, 2, border_radius=12)

        title = self.font.render(f"{active.name} · {active.element}", True, (255, 255, 255))
        self.screen.blit(title, (30, 30))

        hp_width = 220
        hp_bar = pygame.Rect(30, 60, hp_width, 18)
        pygame.draw.rect(self.screen, (90, 90, 100), hp_bar, border_radius=8)
        hp_fill = hp_bar.copy()
        hp_fill.width = hp_width * (active.hp / active.max_hp)
        pygame.draw.rect(self.screen, (120, 220, 120), hp_fill, border_radius=8)
        self.screen.blit(self.font.render(f"HP {int(active.hp)}/{int(active.max_hp)}", True, (255, 255, 255)), (30, 82))

        burst_rect = pygame.Rect(30, 110, 220, 14)
        pygame.draw.rect(self.screen, (70, 70, 90), burst_rect, border_radius=7)
        burst_fill = burst_rect.copy()
        burst_fill.width = 220 * (active.burst_charge / 100)
        pygame.draw.rect(self.screen, (255, 210, 90), burst_fill, border_radius=7)

        team_panel = pygame.Rect(18, HEIGHT - 130, 500, 110)
        pygame.draw.rect(self.screen, (20, 24, 35), team_panel, border_radius=12)
        pygame.draw.rect(self.screen, (55, 60, 90), team_panel, 2, border_radius=12)

        for i, char in enumerate(self.party):
            x = 32 + i * 120
            rect = pygame.Rect(x, HEIGHT - 108, 84, 72)
            if i == self.active_index:
                pygame.draw.rect(self.screen, char.color, rect, 3, border_radius=10)
            else:
                pygame.draw.rect(self.screen, (50, 50, 60), rect, 2, border_radius=10)
            self.screen.blit(self.font.render(str(i + 1), True, (255, 255, 255)), (x + 5, HEIGHT - 100))
            self.screen.blit(self.small_font.render(char.name, True, (255, 255, 255)), (x + 5, HEIGHT - 82))
            self.screen.blit(self.small_font.render(char.element, True, ELEMENT_COLORS.get(char.element, (255, 255, 255))), (x + 5, HEIGHT - 62))

        quest_panel = pygame.Rect(WIDTH - 360, 18, 330, 220)
        pygame.draw.rect(self.screen, (20, 24, 35), quest_panel, border_radius=12)
        pygame.draw.rect(self.screen, (55, 60, 90), quest_panel, 2, border_radius=12)

        title = self.big_font.render("Quests", True, (230, 230, 255))
        self.screen.blit(title, (WIDTH - 332, 30))
        for idx, task in enumerate(self.quest_log):
            y = 86 + idx * 42
            text = f"{idx + 1}. {task['title']} {task['progress']}/{task['goal']}"
            self.screen.blit(self.small_font.render(text, True, (255, 255, 255)), (WIDTH - 332, y))

        stats = self.font.render(
            f"AR {self.adventure_rank} | WL {self.world_level} | Primogems {self.primogems} | Resin {self.resin}/{self.max_resin}",
            True,
            (255, 255, 255),
        )
        self.screen.blit(stats, (32, HEIGHT - 150))

        if self.message:
            msg_box = pygame.Rect(340, HEIGHT - 80, 600, 40)
            pygame.draw.rect(self.screen, (18, 20, 30), msg_box, border_radius=15)
            self.screen.blit(self.font.render(self.message, True, (255, 255, 255)), (355, HEIGHT - 72))

        minimap = pygame.Rect(WIDTH - 190, HEIGHT - 190, 160, 160)
        pygame.draw.rect(self.screen, (18, 20, 28), minimap, border_radius=12)
        pygame.draw.rect(self.screen, (70, 80, 110), minimap, 2, border_radius=12)
        px = (self.player["x"] / WORLD_WIDTH) * 160
        py = (self.player["y"] / WORLD_HEIGHT) * 160
        pygame.draw.circle(self.screen, (100, 220, 130), (int(WIDTH - 190 + px), int(HEIGHT - 190 + py)), 5)


def main():
    game = Game()
    running = True
    while running:
        dt = game.clock.tick(60) / 1000.0
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            else:
                game.handle_event(event)

        game.update(dt)
        game.draw()

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()



















































































































